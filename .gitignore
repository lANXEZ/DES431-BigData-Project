outputs/rejects/

# Cached profiling accumulators: 4.7 MB pickle, purely a build cache that lets
# the kick-off figures be restyled without re-reading the 1.1 GB of CSVs.
#   regenerate with:  python scripts/05_kickoff_figures.py --refresh
outputs/stats/kickoff/_accumulators.pkl

